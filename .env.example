# Copie este arquivo para .env e preencha.
# O .env esta no .gitignore — nunca comite suas chaves.

# Chave gratuita da Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Chave da Ollama Cloud (embeddings nomic-embed-text e modelo gemma4:cloud):
# https://ollama.com -> Settings -> Keys
OLLAMA_API_KEY=

# Endpoint da Ollama Cloud
OLLAMA_BASE_URL=https://ollama.com

# Endpoint dos embeddings. Vazio = Ollama Cloud. Para usar o Ollama instalado no
# computador: ollama pull nomic-embed-text  e preencha com http://localhost:11434
OLLAMA_EMBED_BASE_URL=

# Configuracao do RAG (opcional). Padrao = iteracao 3 com groq:openai/gpt-oss-20b.
# RAG_ITERACAO=iter3
# RAG_PROVEDOR=groq
# RAG_MODELO=openai/gpt-oss-20b
# RAG_K=4
# RAG_LIMIAR=0.45
